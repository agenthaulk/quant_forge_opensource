# Keep local-only material out of the public image AND out of the build
# context upload. `COPY docs/ docs/` (Dockerfile) copies from the context
# with no knowledge of .gitignore, so every gitignored-or-untracked local
# doc would otherwise be baked into the released image — that is exactly
# how the tracked-release cleanliness gate went red inside the container
# (docs/WORKING_STATE.md) while staying green in a git-aware checkout.

# VCS + local tooling state (never image material; huge context otherwise)
.git
.venv
.claude
**/__pycache__
*.pyc

# Runtime/workspace outputs
outputs/
artifacts/
qf-demo/

# Local research + coordination material (mirrors .gitignore docs rules)
worldquant/
docs/WORKING_STATE.md
docs/quant_forge_overall_architecture.*
docs/backtest_rebuild/
docs/rd_evaluation_rebuild/
docs/*_repair_ledger_*.md
docs/first_principles_review_*.md

# Untracked local drafts living under COPY'd dirs
docs/getting_started_zh.md
docs/research_platform_optimization_from_vibe_quantgpt.md

# Local machine setup material at the context root
mac_b_setup/
dropbox_exclude.sh
PROJECT_STATUS.md
TWO_MAC_SYNC.md

# Local secrets and machine-local configs must never enter an image
configs/*.local.yaml
configs/*.local.env
configs/*.secrets.env
*.local.env
*.secrets.env
